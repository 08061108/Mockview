# LLM Configuration
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-flash
LLM_TEMPERATURE=0.7
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_READ_TIMEOUT_SECONDS=90
MODEL_WRITE_TIMEOUT_SECONDS=30
MODEL_POOL_TIMEOUT_SECONDS=10
MODEL_MAX_CONCURRENCY=2
LLM_TRANSPORT_RETRIES=0
LLM_REQUEST_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_MAX_RETRY_AFTER_SECONDS=10
STRUCTURED_REPAIR_ATTEMPTS=1
INTERVIEW_START_TIMEOUT_SECONDS=240
QUESTION_GENERATION_TIMEOUT_SECONDS=120
ANSWER_PROCESSING_TIMEOUT_SECONDS=240
INTERVIEW_START_MAX_ATTEMPTS=2
QUESTION_GENERATION_MAX_ATTEMPTS=2
INTERVIEW_START_MODEL_REQUEST_BUDGET=4
QUESTION_GENERATION_MODEL_REQUEST_BUDGET=4
ANSWER_PROCESSING_MODEL_REQUEST_BUDGET=12
QUESTION_PREFETCH_ENABLED=true
QUESTION_PREFETCH_GLOBAL_LIMIT=1
LLM_SIMPLE_ENABLE_THINKING=false
LLM_COMPLEX_ENABLE_THINKING=true
LLM_COMPLEX_THINKING_BUDGET=2048
LLM_MAX_OUTPUT_TOKENS=4096
# Windows defaults to IPv4 because some provider IPv6 edges terminate TLS early.
MODEL_FORCE_IPV4=true
# Keep model calls independent of ambient HTTP_PROXY/HTTPS_PROXY by default.
MODEL_TRUST_ENV=false
# Optional model-only proxy. On the Windows host use http://127.0.0.1:7897;
# inside Docker use http://host.docker.internal:7897. Leave empty for direct TLS.
MODEL_PROXY_URL=
# Compose maps this value to MODEL_PROXY_URL inside the API container.
DOCKER_MODEL_PROXY_URL=

# Optional bounded public-knowledge correction. Keep disabled until a Tavily
# key is configured. Semantic validators stay in shadow/off mode until the
# fixed evaluation set provides evidence to enable them by default.
PUBLIC_SEARCH_ENABLED=false
PUBLIC_SEARCH_MAX_RESULTS=3
PUBLIC_EXTRACT_MAX_URLS=3
PUBLIC_SNAPSHOT_MAX_CHARS=6000
PUBLIC_SNAPSHOT_TOTAL_MAX_CHARS=12000
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=20
EXTRACT_TIMEOUT_SECONDS=30
PUBLIC_TRANSPORT_RETRIES=2
ASSESSMENT_MAX_DECISIONS=8
ASSESSMENT_MODEL_REQUEST_BUDGET=4
ASSESSMENT_SEARCH_BUDGET=6
ASSESSMENT_EXTRACT_BUDGET=12
ASSESSMENT_SEMANTIC_BUDGET=8
ASSESSMENT_SEMANTIC_ENABLED=false
# Deterministic Hybrid retrieval and evidence assessment always run for the
# preparation flow. This flag enables only bounded LLM Tool Calling on gaps.
ASSESSMENT_AUTONOMOUS_LOOP_ENABLED=false
QUESTION_SEMANTIC_VALIDATION_ENABLED=false
QUESTION_SEMANTIC_SHADOW_ENABLED=false

# Vision (Multi-modal) Configuration — for image resume parsing
# Falls back to LLM_API_KEY / LLM_BASE_URL if not set
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=qwen-vl-ocr

# Embedding Configuration
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_QUERY_BATCH_SIZE=10
EMBEDDING_QUERY_MAX_CONCURRENCY=2
# Keep both strategies on legacy. target_expansion_v1/v2 remain evaluation-only
# until a production hybrid comparison passes quality and latency gates.
RAG_QUERY_STRATEGY=legacy
RAG_QUERY_EXPANSION_LIMIT=2
RAG_RANKING_STRATEGY=legacy
RAG_QUERY_STRATEGY_VERSION=deterministic-v1

# RAG question-bank vector index
CHROMA_PERSIST_DIR=./chroma_data

# Recommended full application storage (host Python and Docker).
# SQLite/Chroma memory backends remain available for focused offline experiments.
MEMORY_DB_PATH=./memory_data/memory.db
MEMORY_STORE_BACKEND=postgres
MEMORY_VECTOR_BACKEND=pgvector
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# Server
HOST=0.0.0.0
PORT=8000
API_HOST_PORT=8000
WEB_PORT=80
DEBUG=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost

# Required: generate with Python secrets.token_urlsafe(48). Never commit the value.
# Blank, known placeholders and weak values prevent API startup.
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=10080
WS_AUTH_TIMEOUT_SECONDS=5
RESUME_UPLOAD_MAX_BYTES=10485760
PREPARATION_TIMEOUT_SECONDS=240
RESUME_PARSE_TIMEOUT_SECONDS=60
RESUME_MODEL_REQUEST_BUDGET=2

# Required for preparation admission limits, including local Python runs.
# Docker Compose overrides the URL to redis://redis:6379/0.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=3
RATE_LIMIT_START_PER_MINUTE=3
RATE_LIMIT_ANSWER_PER_MINUTE=20
RATE_LIMIT_RESUME_PER_HOUR=10
RATE_LIMIT_VISION_PER_DAY=5
REDIS_LOCK_TTL_MS=60000
SESSION_CACHE_TTL_SECONDS=86400
REPORT_CACHE_TTL_SECONDS=604800
WS_PRESENCE_TTL_SECONDS=90

# LangGraph checkpoint persistence.
# Full local app (accounts + sessions + checkpoints) uses PostgreSQL.
CHECKPOINTER_BACKEND=postgres
# Local Python uses localhost. Docker Compose builds the in-container URL from
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD below.
# Leave blank to derive from the fields below (same credentials as Compose).
# An explicit existing URL remains supported and takes precedence.
POSTGRES_URL=
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5432
SESSION_STORE_BACKEND=postgres
POSTGRES_DB=mockview
POSTGRES_USER=mockview
# Use a URL-safe password when this value is interpolated into POSTGRES_URL.
POSTGRES_PASSWORD=change-me-to-a-random-url-safe-password
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=5

# React/Vite build-time variables for the web container.
# Use /api when the frontend is served by the included Nginx container.
VITE_API_BASE_URL=/api
