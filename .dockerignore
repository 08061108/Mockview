# Allowlist: runtime image never receives the full development workspace.
**
!Dockerfile
!requirements.txt
!requirements.lock
!app/
!app/**
!scripts/
!scripts/run_api.py
!scripts/init_vector_store.py
!data/
!data/question_bank/
!data/question_bank/mockview_demo.json
# Re-exclude caches even inside allowed packages.
**/__pycache__/
**/*.pyc
**/*.pyo
**/.env
**/.env.*
